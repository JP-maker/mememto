# Fichier .env du serveur (jamais commité). Copier, remplir, protéger : chmod 600 .env
DOMAIN=mememto.fr
# Préfixe des images GHCR, en minuscules : ghcr.io/<compte>/<dépôt>
IMAGE_PREFIX=ghcr.io/compte/mememto
# Version à lancer (ex. 0.1.0) ; le déploiement automatique la renseigne.
MEMEMTO_VERSION=latest

POSTGRES_DB=mememto
POSTGRES_USER=mememto
POSTGRES_PASSWORD=change-me

# E-mails réels. SMTP OVH « MX Plan » : ssl0.ovh.net, port 587, STARTTLS (Email Pro : pro1.mail.ovh.net ; Exchange : ex.mail.ovh.fr)
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=587
MAIL_USER=contact@mememto.fr
MAIL_PASSWORD=change-me
MAIL_FROM="Mememto <contact@mememto.fr>"

# Connexion Google / Microsoft : redirections https://<DOMAIN>/login/oauth2/code/google et /microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
